# ── Server env (copy ke server/.env saat dev) ───────────────────────
# MongoDB connection string (Atlas atau lokal)
MONGO_URI=mongodb://localhost:27017/hydrocanal

# Secret untuk express-session (ganti dengan random panjang di prod)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Port API server
PORT=4000

# Origin FE yang diizinkan CORS (Vite dev default)
CLIENT_ORIGIN=http://localhost:5173
